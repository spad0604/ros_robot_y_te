<launch>
  <arg name="image_topic" default="/camera/image_raw" />
  <arg name="camera_device" default="/dev/video0" />
  <arg name="vision_python" default="$(find localize_manager)/scripts/vision_python.sh" />
  <arg name="robot_code" default="MEDIBOT-01" />
  <arg name="fire_model" default="$(find localize_manager)/models/fire_smoke.pt" />
  <arg name="fall_model" default="$(find localize_manager)/models/huma_fall.pt" />

  <node pkg="localize_manager"
        type="vision_alert_detector.py"
        name="vision_alert_detector"
        launch-prefix="$(arg vision_python)"
        output="screen"
        respawn="true"
        respawn_delay="15">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="camera_device" value="$(arg camera_device)" />
    <param name="camera_width" value="640" />
    <param name="camera_height" value="480" />
    <param name="camera_fps" value="10.0" />
    <param name="alert_topic" value="/robot/alerts" />
    <param name="robot_code" value="$(arg robot_code)" />
    <param name="fire_model" value="$(arg fire_model)" />
    <param name="fall_model" value="$(arg fall_model)" />
    <param name="target_fps" value="2.0" />
    <param name="image_size" value="640" />
    <param name="confidence" value="0.55" />
    <param name="confirmation_duration_seconds" value="3.0" />
    <param name="track_max_gap_seconds" value="1.25" />
    <param name="track_iou_threshold" value="0.15" />
    <param name="max_frame_age_seconds" value="2.5" />
    <param name="show_window" value="false" />
    <param name="device" value="cpu" />
    <param name="cpu_threads" value="2" />
  </node>
</launch>
